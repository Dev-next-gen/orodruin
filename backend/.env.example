# Orodruin — backend secrets. Copy to backend/.env and fill in.
# NEVER commit the real .env (it is gitignored).
#
# Almost everything works with NO key. Each entry links to where you get it free.

# Google Maps Platform (Photorealistic 3D Tiles). Restrict the key by IP/referrer
# in Google Cloud Console. https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_KEY=

# NASA FIRMS active fires (free). https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# AISStream.io live vessel AIS (free). https://aisstream.io/
AISSTREAM_KEY=

# ACLED conflict events (free account, Research tier for full access).
# https://developer.acleddata.com/
ACLED_EMAIL=
ACLED_PASSWORD=

# Copernicus Data Space Ecosystem (Sentinel-2 imagery + Sentinel-5P air quality).
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Shodan InternetDB is keyless; a key unlocks more. https://account.shodan.io/
SHODAN_KEY=

# OpenSky Network live flights (free OAuth2 client).
# https://opensky-network.org/ (Account -> API clients)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Windy Webcams API (free). https://api.windy.com/keys
WINDY_KEY=

# TomTom Traffic (flow tiles + incidents) + routing (free). https://developer.tomtom.com/
TOMTOM_KEY=

# OpenWeatherMap — planet-wide weather tiles (wind/temp/clouds/pressure/precip).
# Free tier. https://openweathermap.org/api
OPENWEATHER_KEY=

# --- LLM (the AI analyst) — any OpenAI-compatible endpoint ---
# The hosted demo uses DeepSeek. Leave blank for a local llama-server (no key).
# For DeepSeek: base_url https://api.deepseek.com/v1, model deepseek-chat.
# For OpenAI / OpenRouter / Groq / Together: set the three values accordingly.
# All three are also editable in the in-app Settings panel (dev mode only).
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=Qwen3-Coder-Next-Q4_K_M.gguf
LLM_API_KEY=

# --- Production hardening ---
# Set PUBLIC_MODE=true before exposing Orodruin to the internet: hides the Settings
# panel, rejects key/LLM changes over HTTP, and rate-limits the analyst.
PUBLIC_MODE=false
CHAT_RATE_PER_MIN=8

# --- Optional overrides ---
# DATABASE_URL=postgresql+psycopg://osint:osint@localhost:5544/osint
